{
  "info": {
    "name": "LabFlow Planner Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "project_id",
      "value": "1"
    },
    {
      "key": "sample_low_id",
      "value": "1"
    },
    {
      "key": "sample_high_id",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Register user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"manager@example.com\",\"username\":\"labmanager\",\"password\":\"StrongPass123\",\"role\":\"manager\"}"
        }
      }
    },
    {
      "name": "Get token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payload = pm.response.json();",
              "pm.collectionVariables.set('token', payload.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{base_url}}/auth/token",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "manager@example.com"
            },
            {
              "key": "password",
              "value": "StrongPass123"
            }
          ]
        }
      }
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/users/me"
      }
    },
    {
      "name": "Create project",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payload = pm.response.json();",
              "pm.collectionVariables.set('project_id', payload.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/projects",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Enzyme stability sprint\",\"description\":\"Short-cycle screening for formulation candidates\",\"deadline\":\"2026-05-20\",\"status\":\"active\"}"
        }
      }
    },
    {
      "name": "Create qPCR equipment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/equipment",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"qPCR station\",\"method\":\"qPCR\",\"capacity_per_day\":8,\"status\":\"active\",\"calibration_due\":\"2026-06-30\"}"
        }
      }
    },
    {
      "name": "Create low priority sample",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payload = pm.response.json();",
              "pm.collectionVariables.set('sample_low_id', payload.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/samples",
        "body": {
          "mode": "raw",
          "raw": "{\"project_id\":{{project_id}},\"code\":\"ENZ-LOW\",\"material_type\":\"enzyme\",\"required_method\":\"qPCR\",\"priority\":1,\"estimated_hours\":4,\"deadline\":\"2026-05-10\",\"status\":\"new\"}"
        }
      }
    },
    {
      "name": "Create high priority sample",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payload = pm.response.json();",
              "pm.collectionVariables.set('sample_high_id', payload.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/samples",
        "body": {
          "mode": "raw",
          "raw": "{\"project_id\":{{project_id}},\"code\":\"ENZ-HIGH\",\"material_type\":\"enzyme\",\"required_method\":\"qPCR\",\"priority\":5,\"estimated_hours\":4,\"deadline\":\"2026-05-10\",\"status\":\"new\"}"
        }
      }
    },
    {
      "name": "Optimize plan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/planner/optimize",
        "body": {
          "mode": "raw",
          "raw": "{\"sample_ids\":[{{sample_low_id}},{{sample_high_id}}],\"horizon_days\":3,\"start_date\":\"2026-05-01\",\"include_existing_runs\":true}"
        }
      }
    },
    {
      "name": "Commit plan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/planner/commit",
        "body": {
          "mode": "raw",
          "raw": "{\"sample_ids\":[{{sample_low_id}},{{sample_high_id}}],\"horizon_days\":3,\"start_date\":\"2026-05-01\",\"include_existing_runs\":true}"
        }
      }
    },
    {
      "name": "List runs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/runs"
      }
    }
  ]
}
